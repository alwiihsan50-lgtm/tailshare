#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DIR"

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
  # If no GUI display, fallback to DISPLAY :0 if available, else headless
  if [ -e "/tmp/.X11-unix/X0" ]; then
    export DISPLAY=:0
  fi
fi

if [ "$1" = "--server" ] || [ "$1" = "--headless" ] || [ -z "$DISPLAY" ]; then
  echo "🚀 Starting TailShare Server (Headless/Daemon Mode)..."
  exec /home/cuker/.local/bin/node src/server/index.js
else
  echo "⚡ Starting TailShare Native Desktop App..."
  exec "$DIR/node_modules/.bin/electron" --no-sandbox src/electron/main.js "$@"
fi
